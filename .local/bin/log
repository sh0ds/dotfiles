#!/bin/bash

set -euo pipefail

f=~/code/website/content/log/index.md

if [ $# -eq 0 ]
  then
    echo "No arguments supplied - usage: log <step>"
    exit 1
fi

if ! grep "^## $1 ·" "$f"
  then
    printf '\n## %s ·\nDid:\nStuck:\nLearned:\nRedo:\nNext:\n' "$1" >>"$f"
fi

exec zeditor ~/code/website "$f:$(wc -l <"$f")"
