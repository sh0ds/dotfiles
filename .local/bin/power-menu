#!/usr/bin/env bash
# power-menu: size a text-only session console for every output, including
# portrait and HiDPI screens. Dimensions from Hyprland are physical pixels.
set -euo pipefail
width=1280 height=720
if size=$(hyprctl monitors -j 2>/dev/null | jq -er '
  [.[] | select(.disabled != true) |
    (.scale // 1) as $s |
    if ((.transform // 0) % 2) == 1
    then {w:(.height / $s | floor), h:(.width / $s | floor)}
    else {w:(.width / $s | floor), h:(.height / $s | floor)} end] |
  select(length > 0) | "\(map(.w) | min) \(map(.h) | min)"'); then
  read -r width height <<<"$size"
fi
[[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] || exit 1
# Five compact rows rather than screen-sized icon tiles. The narrowest
# logical output sets the width; cap the height for short laptop displays.
menu_width=420
(( menu_width > width - 32 )) && menu_width=$((width - 32))
menu_height=360
(( menu_height > height - 32 )) && menu_height=$((height - 32))
side=$(( (width - menu_width) / 2 )); (( side < 16 )) && side=16
top=$(( (height - menu_height) / 2 )); (( top < 16 )) && top=16
exec wlogout -b 1 -L "$side" -R "$side" -T "$top" -B "$top"
