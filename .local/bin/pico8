#!/usr/bin/env bash
# pico8: PICO-8 from ~/.local/opt/pico-8 (the zip from lexaloffle.com, not in
# this repo). Jumps to it if it's already open. Carts live in ~/code/pico8,
# screenshots and GIFs (F6, F9) land in ~/Pictures/pico-8. Arguments go to
# PICO-8 (cart-run uses -run CART). PICO8_NEW=1 starts another PICO-8 next
# to an open one instead of jumping to it (cart-run, for a second cart).
set -euo pipefail
dir=${PICO8_DIR:-$HOME/.local/opt/pico-8}
bin=
for b in pico8 pico8_64 pico8_dyn; do
  [ -x "$dir/$b" ] && { bin=$dir/$b; break; }
done
if [ -z "$bin" ]; then
  notify-send -a PICO-8 "PICO-8 is not installed" "Unzip the Linux download so $dir/pico8 exists."
  exit 1
fi
mkdir -p ~/code/pico8 ~/Pictures/pico-8
# Lua language server settings for Zed (PICO-8's API and syntax, whole .p8
# carts), kept in step with the dotfiles on every start; commit it with the
# carts when it changes. See docs/gamedev.md.
luarc=$HOME/code/pico8/.luarc.json
sed "s|@HOME@|$HOME|" ~/.local/share/fantasy-lua/pico8.luarc.json >"$luarc.new"
if cmp -s "$luarc.new" "$luarc"; then rm "$luarc.new"; else mv "$luarc.new" "$luarc"; fi
# Zed settings for this folder: lets the language servers run that plugin
# (see the file). Written once; commit it too.
zed_settings=$HOME/code/pico8/.zed/settings.json
if [ ! -e "$zed_settings" ]; then
  mkdir -p "${zed_settings%/*}"
  cp ~/.local/share/fantasy-lua/pico8.zed-settings.json "$zed_settings"
elif ! grep -q trustByClient "$zed_settings"; then
  notify-send -a PICO-8 "Zed won't load the PICO-8 API" \
    "Add the lsp part of ~/.local/share/fantasy-lua/pico8.zed-settings.json to $zed_settings."
fi
# p8guard stops a save in PICO-8 from bringing back code Zed has changed
# since (see its header). One runs at a time; it quits after PICO-8 does.
setsid -f p8guard </dev/null >/dev/null 2>&1
# Windowed so Hyprland tiles it; pixel_perfect keeps whole-number scaling,
# so the 128x128 screen stays sharp and the rest is Afterhours black.
flags=(-windowed 1 -pixel_perfect 1 -root_path "$HOME/code/pico8" -desktop "$HOME/Pictures/pico-8")
if [ "${PICO8_NEW:-}" = 1 ]; then
  exec "$bin" "${flags[@]}" "$@"
fi
exec app '(?i)^(pico-?8.*)$' "$bin" "${flags[@]}" "$@"
