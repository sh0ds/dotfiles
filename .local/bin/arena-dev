#!/usr/bin/env bash
# arena-dev: open (or reattach to) the Pi Arena tmux session.
# One window per part of the plan, each starting in its directory.
#   1 edit    nvim at the repo root
#   2 engine  Haskell (cabal repl / stack ghci)
#   3 server  Erlang (rebar3 shell)
#   4 ai      C and ARM64 asm (make, qemu-aarch64, gdb)
#   5 db      sqlite3
#   6 pi      ssh to rasberry-pizian
set -euo pipefail

# Opened from SUPER+A the terminal closes on exit, hiding any error: wait for Enter.
trap 'echo "arena-dev failed (line $LINENO). Press Enter to close."; read -r' ERR

repo=${ARENA_REPO:-$HOME/code/pi-arena}
session=arena

command -v tmux >/dev/null || { echo "arena-dev: tmux is not installed (sudo pacman -S tmux)"; false; }

# Before step D8 the repo doesn't exist yet: create the folders so the session still opens.
mkdir -p "$repo"/{engine,server,ai,db,ops}

if ! tmux has-session -t "$session" 2>/dev/null; then
  tmux new-session -d -s "$session" -n edit -c "$repo"
  tmux send-keys -t "$session:edit" "nvim ." Enter
  for part in engine server ai db; do
    tmux new-window -t "$session" -n "$part" -c "$repo/$part"
  done
  tmux new-window -t "$session" -n pi -c "$repo"
  tmux send-keys -t "$session:pi" "ssh pi" Enter
  tmux select-window -t "$session:edit"
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$session"
else
  tmux attach-session -t "$session"
fi
