#!/usr/bin/env bash
# sysmon: btop (CTRL+SHIFT+Escape, or click the cpu, mem or the temperature
# in the bar). Jumps to it, starts it, or jumps back.
# btop rewrites btop.conf on exit. The installer copies its Diag defaults,
# and this wrapper also selects Diag for pre-existing installations.
set -euo pipefail
conf=${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf
mkdir -p "${conf%/*}"
[ -e "$conf" ] || : >"$conf"
set_opt() {
  if grep -q "^$1 *=" "$conf"; then
    sed -i "s|^$1 *=.*|$1 = $2|" "$conf"
  else
    printf '%s = %s\n' "$1" "$2" >>"$conf"
  fi
}
set_opt color_theme '"diag"'
set_opt theme_background false   # kitty's black behind it
set_opt vim_keys true            # h j k l in the process list
exec app --toggle '^sysmon$' kitty --class sysmon -e btop
