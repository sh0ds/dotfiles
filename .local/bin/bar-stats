#!/usr/bin/env bash
# bar-stats: compact Waybar diagnostics; GPU/network detail lives in the tooltip.
# bar-stats toggle opens/closes the readings without crowding out other modules.
set -uo pipefail
umask 077
run=${XDG_RUNTIME_DIR:-/tmp/diag-$UID}/diag-bar
mkdir -p "$run"
# Multiple bars can sample together. Serialize the read/update of cached counters.
exec 9>"$run/lock"
flock -w 2 9 || exit 1
open=$run/open
key() { printf "<span color='#1793d1'>%s:</span>" "$1"; }

if [ "${1:-}" = toggle ]; then
  if [ -e "$open" ]; then
    rm -f "$open"
  else
    : >"$open"
    rm -f "$run/cpu" "$run/net"
  fi
  pkill -RTMIN+9 waybar || true
  exit 0
fi

if [ ! -e "$open" ]; then
  jq -cn --arg text "<span color='#1793d1'>sys</span>" \
    '{text:$text, class:"closed", tooltip:"click: cpu, mem, temp · hover: gpu, net · right-click: btop"}'
  exit 0
fi

read -r _ u n s i w q sq st _ </proc/stat
busy=$((u + n + s + q + sq + st)); total=$((busy + i + w))
cpu=0
if read -r pb pt 2>/dev/null <"$run/cpu" && [ "$total" -gt "$pt" ] && [ "$busy" -ge "$pb" ]; then
  cpu=$(( (busy - pb) * 100 / (total - pt) ))
fi
printf '%s %s\n' "$busy" "$total" >"$run/cpu"
mem=$(awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{printf "%.1fG", (t-a)/1048576}' /proc/meminfo)

temp=
for h in /sys/class/hwmon/hwmon*; do
  case $(cat "$h/name" 2>/dev/null) in
    coretemp|k10temp)
      value=$(cat "$h/temp1_input" 2>/dev/null) || continue
      [[ $value =~ ^[0-9]+$ ]] || continue
      temp=$((value / 1000)); break ;;
  esac
done

gpu=n/a
if command -v nvidia-smi >/dev/null; then
  value=$(timeout 1 nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)
  [[ $value =~ ^[0-9]+$ ]] && gpu="$value%"
fi

dev=$(ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}')
net='net: down'
if [ -n "$dev" ] && [ -r "/sys/class/net/$dev/statistics/rx_bytes" ]; then
  rx=$(cat "/sys/class/net/$dev/statistics/rx_bytes")
  tx=$(cat "/sys/class/net/$dev/statistics/tx_bytes")
  read -r uptime _ </proc/uptime
  now=${uptime%%.*}
  down=0 up=0
  # Interface changes, reconnects and counter resets are not negative rates.
  if read -r pd pr ptx pn 2>/dev/null <"$run/net" && [ "$pd" = "$dev" ] &&
     [ "$now" -gt "$pn" ] && [ "$rx" -ge "$pr" ] && [ "$tx" -ge "$ptx" ]; then
    down=$(( (rx - pr) / (now - pn) )); up=$(( (tx - ptx) / (now - pn) ))
  fi
  printf '%s %s %s %s\n' "$dev" "$rx" "$tx" "$now" >"$run/net"
  human() { numfmt --to=iec --suffix=B --format='%.0f' "$1"; }
  label=eth; [ -d "/sys/class/net/$dev/wireless" ] && label=wifi
  net="$label: down $(human "$down")/s · up $(human "$up")/s"
fi

out="$(key cpu)$(printf '%3s' "$cpu")%  $(key mem) $mem"
[ -n "$temp" ] && out+="  $(key temp) $temp°C"
class=open
[ -n "$temp" ] && [ "$temp" -ge 85 ] && class=hot
printf -v tip 'cpu: %s%%\nmem: %s\ntemp: %s\ngpu: %s\n%s\nclick: close · right-click: btop' \
  "$cpu" "$mem" "${temp:-n/a}" "$gpu" "$net"
jq -cn --arg text "$out" --arg class "$class" --arg tooltip "$tip" \
  '{text:$text, class:$class, tooltip:$tooltip}'
