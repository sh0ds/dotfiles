#!/usr/bin/env bash
# default-apps: folders in Thunar, videos in mpv, pictures in imv, PDFs in zathura,
# from Thunar, Firefox downloads, udiskie or xdg-open. Run it once after
# installing them; it only touches these file types in ~/.config/mimeapps.list.
set -euo pipefail
for program in thunar xarchiver; do
  command -v "$program" >/dev/null || { echo "default-apps: install $program before setting the file-manager defaults" >&2; exit 1; }
done
xdg-mime default thunar.desktop inode/directory
# Archive browsing stays separate from extracting through Thunar's context menu.
xdg-mime default xarchiver.desktop \
  application/zip application/x-7z-compressed application/vnd.rar application/x-rar \
  application/x-tar application/gzip application/x-bzip2 application/x-xz application/zstd \
  application/x-zstd application/x-compressed-tar application/x-bzip-compressed-tar \
  application/x-xz-compressed-tar application/x-zstd-compressed-tar
xdg-mime default mpv.desktop \
  video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo video/mpeg video/ogg \
  audio/mpeg audio/flac audio/ogg audio/opus audio/x-wav audio/mp4
xdg-mime default imv.desktop \
  image/png image/jpeg image/gif image/webp image/bmp image/tiff image/avif image/svg+xml
xdg-mime default org.pwmt.zathura-pdf-mupdf.desktop \
  application/pdf application/epub+zip application/oxps
echo "Done: folders in Thunar, archives in Xarchiver, video and audio in mpv, pictures in imv, PDFs in zathura."
