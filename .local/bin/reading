#!/usr/bin/env bash
# reading: reading layout on/off for the workspace you're on (SUPER+R).
#   On:  this workspace switches to the master layout, centred: the focused
#        window (the doc) sits in the middle at half the width, the others
#        stack on its left and right. Nothing moves to another workspace.
#   Off: (SUPER+R again) back to the normal dwindle tiling.
# One window alone stays in the middle; with two, the doc is on the left.
# A config reload (hyprctl reload) also ends it.
#
# How: a workspace rule for this workspace sets layout = "master", added at
# runtime with hyprctl eval. Rules are merged, so the workspace keeps its
# monitor. Setting master.mfact (rice.lua's 0.5) in the same eval makes
# Hyprland re-check every workspace's layout right away.
set -euo pipefail
read -r ws layout < <(hyprctl activeworkspace -j | jq -r '"\(.id) \(.tiledLayout)"')
ev() { hyprctl eval "$1" >/dev/null; }

if [ "$layout" = master ]; then
  ev "hl.workspace_rule({ workspace = \"$ws\", layout = \"dwindle\" }); hl.config({ master = { mfact = 0.5 } })"
  exit 0
fi

doc=$(hyprctl activewindow -j | jq -r '.address // empty')
ev "hl.workspace_rule({ workspace = \"$ws\", layout = \"master\", layout_opts = { orientation = \"center\" } }); hl.config({ master = { mfact = 0.5 } })"
# The layout switch happens on Hyprland's next loop; then the doc takes the middle.
sleep 0.15
if [ -n "$doc" ]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$doc\" })" >/dev/null
  hyprctl dispatch 'hl.dsp.layout("swapwithmaster ignoremaster")' >/dev/null
fi
