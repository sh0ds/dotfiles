#!/usr/bin/env bash
# wall-next: random wallpaper from ~/Pictures/walls, grown out from the mouse (awww).
# Bound to SUPER+W in ~/.config/hypr/rice.lua.
set -euo pipefail

dir=${WALL_DIR:-$HOME/Pictures/walls}
link=$HOME/Pictures/wall.png
mkdir -p "$dir"
# First run: wall.png is still your real wallpaper, not a link. Move it into
# the pile instead of overwriting it below.
if [ -f "$link" ] && [ ! -L "$link" ]; then
  mv -n "$link" "$dir/wall-$(date +%Y%m%d-%H%M%S).png"
fi
# Never pick the one that's already up, or the key looks like it did nothing.
current=$(readlink -f "$link" 2>/dev/null || true)
walls=$(find "$dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \))
[ -n "$walls" ] || { notify-send "wall-next" "No images in $dir"; exit 1; }
img=$(grep -vxF -- "$current" <<<"$walls" | shuf -n1 || true)
[ -n "$img" ] || img=$walls   # only one image: show it anyway

# hyprctl gives "x, y" from the top; awww counts y from the bottom, hence --invert-y.
pos=$(hyprctl cursorpos | tr -d ' ')
awww img "$img" --transition-type grow --transition-pos "$pos" --invert-y \
  --transition-duration 1.2 --transition-fps 60

# Keep ~/Pictures/wall.png pointing at the current image (hyprlock, SDDM, fallback).
ln -sfn "$img" "$link"
