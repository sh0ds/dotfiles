#!/usr/bin/env bash
# scratch: show/hide a drop-down window, starting it on first use.
# Usage: scratch CLASS WORKSPACE COMMAND...
# dropterm, chat and quicknote all go through this. rice.lua has a rule per
# CLASS that floats it in the drop-down frame and parks it in special:WORKSPACE.
set -euo pipefail
class=$1 ws=$2
shift 2
running() { hyprctl clients -j | jq -e --arg c "$class" 'any(.[]; .class == $c)' >/dev/null; }
if ! running; then
  "$@" >/dev/null 2>&1 & disown
  # wait until the window exists, so the toggle below shows it
  for _ in $(seq 20); do
    running && break
    sleep 0.1
  done
fi
hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$ws\")"
