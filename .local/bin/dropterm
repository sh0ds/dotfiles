#!/usr/bin/env bash
# dropterm: show/hide the drop-down kitty (SUPER+Z). Starts it on first use.
# rice.lua's "dropterm" rule floats it and parks it in special:term.
if ! hyprctl clients -j | jq -e 'any(.[]; .class == "dropterm")' >/dev/null; then
  kitty --class dropterm & disown
  # wait until the window exists, so the toggle below shows it
  for _ in $(seq 20); do
    hyprctl clients -j | jq -e 'any(.[]; .class == "dropterm")' >/dev/null && break
    sleep 0.1
  done
fi
hyprctl dispatch 'hl.dsp.workspace.toggle_special("term")'
