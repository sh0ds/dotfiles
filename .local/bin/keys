#!/usr/bin/env bash
# keys: desktop shortcuts in a searchable fuzzel list (SUPER+F1). Read straight
# from the shortcut table in the dotfiles repo (docs/keys.md).
set -euo pipefail
repo=$(dirname "$(dirname "$(dirname "$(readlink -f ~/.config/hypr/rice.lua)")")")
# shellcheck disable=SC2016  # the backticks are literal Markdown
awk -F' \\| ' '/^\| `/ { k = substr($1, 3); a = $2; sub(/ \|$/, "", a); gsub(/`/, "", k); gsub(/`/, "", a)
                         printf "%-34s %s\n", k, a }' "$repo/docs/keys.md" |
  fuzzel --dmenu --prompt 'keys: ' --lines 15 --width 75 >/dev/null || true
