#!/usr/bin/env bash
# Afterhours shell control. Quickshell handles IPC and duplicate-instance checks.
set -euo pipefail
if ! command -v quickshell >/dev/null; then
  printf 'Afterhours needs Quickshell 0.3.2 or newer. Install quickshell on Arch.\n' >&2
  exit 1
fi
case ${1:-start} in
  # From a terminal the shell is detached, so closing the terminal doesn't
  # take the rail with it; Hyprland's start hook runs it the same way.
  start) exec setsid -f quickshell -c afterhours --no-duplicate >/dev/null 2>&1 ;;
  # Stop the running shell and start a fresh one (after a config change).
  restart)
    quickshell kill -c afterhours >/dev/null 2>&1 || true
    sleep 0.3
    exec setsid -f quickshell -c afterhours --no-duplicate >/dev/null 2>&1 ;;
  # In the foreground with its log, for debugging.
  debug) exec quickshell -c afterhours --no-duplicate ;;
  studio|apps|inbox|session) exec quickshell ipc -c afterhours call shell toggle "$1" ;;
  status) exec quickshell ipc -c afterhours call shell status ;;
  close) exec quickshell ipc -c afterhours call shell close ;;
  bar) exec quickshell ipc -c afterhours call shell toggleBar ;;
  quiet) exec quickshell ipc -c afterhours call shell quietMode "${2:-true}" ;;
  *) echo 'Usage: afterhours [start|restart|debug|studio|apps|inbox|session|status|close|bar|quiet true|false]' >&2; exit 2 ;;
esac
