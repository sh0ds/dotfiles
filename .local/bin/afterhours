#!/usr/bin/env bash
# Afterhours shell control. Quickshell handles IPC and duplicate-instance checks.
set -euo pipefail
if ! command -v quickshell >/dev/null; then
  printf 'Afterhours needs Quickshell 0.3.2 or newer. Install quickshell on Arch.\n' >&2
  exit 1
fi
case ${1:-start} in
  # From a terminal the shell is detached, so closing the terminal doesn't
  # take the rail with it; Hyprland's start hook runs it the same way.
  # --arrive (only Hyprland's start hook passes it) opens the session from
  # the Afterhours mark, see Arrive.qml.
  start)
    unset AFTERHOURS_ARRIVE
    [ "${2:-}" = --arrive ] && export AFTERHOURS_ARRIVE=1
    exec setsid -f quickshell -c afterhours --no-duplicate >/dev/null 2>&1 ;;
  # Stop the running shell and start a fresh one (after a config change).
  restart)
    quickshell kill -c afterhours >/dev/null 2>&1 || true
    sleep 0.3
    unset AFTERHOURS_ARRIVE
    exec setsid -f quickshell -c afterhours --no-duplicate >/dev/null 2>&1 ;;
  # In the foreground with its log, for debugging.
  debug) unset AFTERHOURS_ARRIVE; exec quickshell -c afterhours --no-duplicate ;;
  apps|inbox|session) exec quickshell ipc -c afterhours call shell toggle "$1" ;;
  status) exec quickshell ipc -c afterhours call shell status ;;
  close) exec quickshell ipc -c afterhours call shell close ;;
  bar) exec quickshell ipc -c afterhours call shell toggleBar ;;
  quiet) exec quickshell ipc -c afterhours call shell quietMode "${2:-true}" ;;
  overview) exec quickshell ipc -c afterhours call shell overview ;;
  # The launcher with a mode typed: = maths, > commands, / windows, : emoji.
  launch) exec quickshell ipc -c afterhours call shell launch "${2:-}" ;;
  game) exec quickshell ipc -c afterhours call shell game "${2:-true}" ;;
  # Lock, and only report success once the lock really holds, so callers
  # (hypridle, Super+Escape, afterhours-suspend) can fall back to hyprlock.
  lock)
    quickshell ipc -c afterhours call shell lock >/dev/null 2>&1 || exit 1
    for _ in $(seq 20); do
      [ "$(quickshell ipc -c afterhours call shell locked 2>/dev/null)" = true ] && exit 0
      sleep 0.1
    done
    exit 1 ;;
  *) echo 'Usage: afterhours [start|restart|debug|apps|inbox|session|status|close|bar|quiet true|false|overview|launch PREFIX|game true|false|lock]' >&2; exit 2 ;;
esac
