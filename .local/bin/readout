#!/usr/bin/env bash
# readout: five quiet diagnostic lines on the wallpaper, bottom left, like a
# bootloader's status screen. rice.lua runs it in a kitty panel on the
# background layer, so windows cover it and an empty workspace shows it.
#   up     uptime
#   pi     answers a ping or not
#   play   what's playing (any player playerctl sees)
#   next   the Next: line of your newest LOG.md entry
#   log    days of the last seven with a LOG.md commit (from wall-streak)
set -uo pipefail
log=${SITE_REPO:-$HOME/code/website}/LOG.md
days=${XDG_CACHE_HOME:-$HOME/.cache}/diag-log-days
pi=${PI_HOST:-192.168.178.36}
label=$'\e[38;2;23;147;209m' value=$'\e[38;2;93;102;112m' warn=$'\e[38;2;229;72;77m' off=$'\e[0m'

line() { printf '%s%-5s%s %s\n' "$label" "$1" "$off" "$value${2:-}$off"; }

printf '\e[?25l'   # no cursor
trap 'printf "\e[?25h"' EXIT
while :; do
  up=$(uptime -p 2>/dev/null | sed 's/^up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/; s/,//g')
  if ping -c 1 -W 1 "$pi" >/dev/null 2>&1; then p=up; else p="${warn}down"; fi
  play=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | cut -c1-60)
  next=$(awk '/^Next:/ { n = $0 } END { sub(/^Next:[ \t]*/, "", n); print n }' "$log" 2>/dev/null | cut -c1-60)
  printf '\e[H\e[2J'
  line up "$up"
  line pi "$p"
  line play "${play:--}"
  line next "${next:--}"
  line log "$(cat "$days" 2>/dev/null || echo '?')/7"
  sleep 10
done
