#!/usr/bin/env bash
# calendar: show/hide Proton Calendar (SUPER+Y, or click the clock in the bar).
# It's a PWAsForFirefox app like SoundCloud. Put its ID from
# `firefoxpwa profile list` in the id line below; rice.lua reads it from here
# too, so this is the only place it goes.
id=01M5CSJASAHKH83FX9YKG9K4GR
if [[ $id == *XXXX* ]]; then
  notify-send -a Calendar "Calendar isn't set up" "Install Proton Calendar with PWAsForFirefox and put its ID in ~/.local/bin/calendar"
  exit 1
fi
exec scratch "$id" calendar firefoxpwa site launch "${id#FFPWA-}"
