#!/usr/bin/env bash
# pi-status: waybar module. Prints JSON saying whether the Pi answers a ping,
# as a diagnostic line: "pi: up", or "pi: down" with down in red.
pi=${PI_HOST:-192.168.178.36}
key="<span color='#e5484d'>pi</span><span color='#75c94d'>:</span>"
if ping -c 1 -W 1 "$pi" >/dev/null 2>&1; then
  printf '{"text":"%s up","class":"up","tooltip":"Raspberry Pi (%s) is up"}\n' "$key" "$pi"
else
  printf '{"text":"%s <span color='"'"'#e5484d'"'"'>down</span>","class":"down","tooltip":"Raspberry Pi (%s) is not answering"}\n' "$key" "$pi"
fi
