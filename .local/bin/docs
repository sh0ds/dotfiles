#!/usr/bin/env bash
# docs: search the docs for the game plan from anywhere (SUPER+D).
# Type a prefix and a query:
#   g node2d       Godot docs
#   8 sspr         PICO-8 wiki (API pages and examples)
#   w hyprland     Arch Wiki
#   m printf       man page in kitty (C library and commands)
#   anything else  web search (DuckDuckGo)
set -euo pipefail
q=$(fuzzel --dmenu --prompt-only 'docs: ' --placeholder 'g node2d · 8 sspr · w hyprland · m printf' --width 50) || exit 0
[ -n "$q" ] || exit 0
enc() { jq -rn --arg s "$1" '$s|@uri'; }
rest=${q#* }
case "$q" in
  "g "*) xdg-open "https://docs.godotengine.org/en/stable/search.html?q=$(enc "$rest")" ;;
  "8 "*) xdg-open "https://pico-8.fandom.com/wiki/Special:Search?query=$(enc "$rest")" ;;
  "w "*) xdg-open "https://wiki.archlinux.org/index.php?search=$(enc "$rest")" ;;
  "m "*) kitty --class docs-man -e man "$rest" & disown ;;
  *)     xdg-open "https://duckduckgo.com/?q=$(enc "$q")" ;;
esac
