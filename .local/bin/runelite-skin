#!/usr/bin/env python3
# runelite-skin: builds the Mocha skin for OSRS. Downloads the RuneLITE
# resource pack by Smoke (flat, dark grey, gold accents), turns its greys
# into Mocha's base shades and its gold into mauve, and saves it to
# ~/.local/share/runelite-mocha, where my RuneLite profile looks for it.
# Also puts your wallpaper on the login screen.
# Item, skill, prayer and spell icons keep their own colours.
# Run it again whenever the pack gets an update.
# Usage: runelite-skin              (or: runelite-skin DIR to use a local copy)
#        runelite-skin --login      only redo the login screen (wall-next runs this)
import colorsys, io, os, re, shutil, sys, tarfile, tempfile, urllib.request
from PIL import Image

URL = "https://github.com/melkypie/resource-packs/archive/refs/heads/pack-RuneLITE.tar.gz"
OUT = os.path.expanduser("~/.local/share/runelite-mocha")

hx = lambda s: tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))
# grey level in the pack -> Mocha shade
GREYS = [(v, hx(c)) for v, c in [
    (0x00, "11111b"), (0x17, "11111b"), (0x1e, "181825"), (0x28, "1e1e2e"), (0x33, "313244"),
    (0x45, "45475a"), (0x5a, "585b70"), (0x80, "7f849c"), (0xa0, "a6adc8"), (0xc8, "bac2de"),
    (0xff, "cdd6f4")]]
MAUVE = [(0.0, hx("11111b")), (0.25, hx("4e3f6e")), (0.55, hx("cba6f7")), (1.0, hx("ead9fc"))]
# folders that are only icons, left alone
ICONS = ("emote", "prayer", "skill", "impling", "sailing", "login_screen", "welcome_screen",
         "quests_tab", "account_management", "icon")
# in tab/ only the tab shapes are recoloured, not the icons on them
TAB_FRAMES = ("large_", "medium_", "small_", "side_border", "stone_", "stash_units", "transparent_")

def ramp(stops, x):
    if x <= stops[0][0]:
        return stops[0][1]
    for (a, ca), (b, cb) in zip(stops, stops[1:]):
        if x <= b:
            t = (x - a) / (b - a)
            return tuple(round(p + (q - p) * t) for p, q in zip(ca, cb))
    return stops[-1][1]

def shade(r, g, b):
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    if s < 0.2 or (l < 0.12 and s < 0.5):
        return ramp(GREYS, (r * 299 + g * 587 + b * 114) / 1000)
    if 15 <= h * 360 <= 65:  # the pack's gold accent
        return ramp(MAUVE, l)
    return None

def recolour(path, dst):
    im = Image.open(path).convert("RGBA")
    px = im.load()
    for y in range(im.height):
        for x in range(im.width):
            r, g, b, a = px[x, y]
            if a and (c := shade(r, g, b)):
                px[x, y] = (*c, a)
    im.save(dst, optimize=True)

def hexsub(m):
    v = m.group(1)
    c = shade(*hx(v[-6:]))
    return "0x" + v[:-6] + ("".join(f"{x:02x}" for x in c) if c else v[-6:])

def build(src):
    tmp = OUT + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    n = 0
    for root, _, files in os.walk(src):
        rel = os.path.relpath(root, src)
        top = rel.split(os.sep)[0]
        for f in files:
            s, d = os.path.join(root, f), os.path.join(tmp, rel, f)
            os.makedirs(os.path.dirname(d), exist_ok=True)
            icon = top.endswith("_spell") or top in ICONS or rel == "." or (top == "tab" and not f.startswith(TAB_FRAMES))
            if f.endswith(".png") and not icon:
                recolour(s, d)
                n += 1
            elif f == "color.properties":
                text = re.sub(r"0x([0-9a-fA-F]{6,8})", hexsub, open(s).read())
                # The pack sets an opaque overlay colour and would override the
                # profile's see-through one: use the bar's glass (base at 80%).
                text = re.sub(r"(?m)^overlay_color=.*$", "overlay_color=0xcc1e1e2e", text)
                open(d, "w").write(text)
            elif f != "README.md":
                shutil.copy(s, d)
    with open(os.path.join(tmp, "pack.properties"), "w") as p:
        p.write("displayName=RuneLITE Mocha\nauthor=Smoke, recoloured by sh0ds\n")
    with open(os.path.join(tmp, "chat_colors.toml"), "w") as p:
        p.write(CHAT)
    shutil.rmtree(OUT, ignore_errors=True)
    os.rename(tmp, OUT)
    print(f"{n} sprites in Mocha, saved to {OUT}")

# chat text on the transparent chatbox
CHAT = """[transparent]
public_chat=0xcdd6f4
public_chat_highlight=0x89b4fa
private_message_sent=0x94e2d5
private_message_sent_highlight=0x89dceb
private_message_received=0x94e2d5
private_message_received_highlight=0x89dceb
friends_chat_info=0xa6e3a1
clan_chat_message=0xa6e3a1
clan_chat_message_highlight=0xf9e2af
clan_info=0xa6e3a1
clan_message=0xa6e3a1
clan_message_highlight=0xf9e2af
clan_guest_info=0x94e2d5
clan_guest_message=0x94e2d5
autochat_message=0x7f849c
trade_chat_message=0xf5c2e7
game_message=0xcdd6f4
examine=0xbac2de
username=0xcba6f7
player_username=0xcba6f7
private_usernames=0xcba6f7
public_friend_usernames=0xb4befe
"""

def login_screen():
    # The login screen gets your current wallpaper, darkened a little so
    # the login box stays readable. RuneLite reads login.png from its own
    # folder, which Bolt keeps somewhere under ~/.local/share.
    wall = os.path.expanduser("~/Pictures/wall.png")
    if not os.path.exists(wall):
        return
    dirs = {os.path.expanduser("~/.runelite")}
    for root, ds, _ in os.walk(os.path.expanduser("~/.local/share")):
        if root.count(os.sep) - os.path.expanduser("~").count(os.sep) > 6:
            ds[:] = []
        if ".runelite" in ds:
            dirs.add(os.path.join(root, ".runelite"))
    im = Image.open(wall).convert("RGB")
    w, h = 765, 503
    scale = max(w / im.width, h / im.height)
    im = im.resize((round(im.width * scale), round(im.height * scale)), Image.LANCZOS)
    x, y = (im.width - w) // 2, (im.height - h) // 2
    im = Image.blend(im.crop((x, y, x + w, y + h)), Image.new("RGB", (w, h), hx("1e1e2e")), 0.3)
    for d in dirs:
        if os.path.isdir(d):
            im.save(os.path.join(d, "login.png"))
            print("login screen:", os.path.join(d, "login.png"))

if sys.argv[1:] == ["--login"]:
    pass
elif len(sys.argv) > 1:
    build(sys.argv[1])
else:
    with tempfile.TemporaryDirectory() as t:
        print("downloading the RuneLITE pack...")
        with urllib.request.urlopen(URL) as r:
            tarfile.open(fileobj=io.BytesIO(r.read())).extractall(t, filter="data")
        build(os.path.join(t, os.listdir(t)[0]))
login_screen()
