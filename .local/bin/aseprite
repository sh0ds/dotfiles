#!/usr/bin/env bash
# aseprite: Aseprite from Steam (app 431730), always started as the binary,
# never through the Steam client (the Linux build is DRM-free).
#   aseprite                  open it, or jump to it if it's open
#   aseprite FILE...          open files in it
#   aseprite -b sprite.aseprite --sheet out.png ...
#                             the batch CLI, for sprite sheets in build scripts
set -euo pipefail
bin=${ASEPRITE_BIN:-$HOME/.local/share/Steam/steamapps/common/Aseprite/aseprite}
if [ ! -x "$bin" ]; then
  echo "aseprite: no binary at $bin (install it in Steam or set ASEPRITE_BIN)" >&2
  notify-send -a Aseprite "Aseprite is not installed" "No binary at $bin" 2>/dev/null || true
  exit 1
fi
# The batch CLI and files go straight to the binary; a plain start jumps
# to an open window first.
[ "$#" -gt 0 ] && exec "$bin" "$@"
exec app '(?i)^aseprite$' "$bin"
