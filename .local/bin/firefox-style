#!/usr/bin/env bash
# firefox-style: links ~/.config/firefox (userChrome.css, userContent.css,
# user.js: the Diag look) into every Firefox profile it finds. Closes Firefox
# first and waits for it, because Firefox rewrites its prefs on exit. After
# that, edits in ~/.config/firefox show up on the next start.
set -euo pipefail
src=$HOME/.config/firefox

if pgrep -x firefox >/dev/null || pgrep -x firefox-bin >/dev/null; then
  echo "Closing Firefox..."
  pkill -x firefox || true; pkill -x firefox-bin || true
  for _ in $(seq 50); do
    pgrep -x firefox >/dev/null || pgrep -x firefox-bin >/dev/null || break
    sleep 0.2
  done
  if pgrep -x firefox >/dev/null || pgrep -x firefox-bin >/dev/null; then
    echo "Firefox is still running, close it and run this again." >&2; exit 1
  fi
fi

n=0
for base in "$HOME/.config/mozilla/firefox" "$HOME/.mozilla/firefox"; do
  ini=$base/profiles.ini
  [ -f "$ini" ] || continue
  # Every Path= in profiles.ini, relative or absolute
  while IFS= read -r rel; do
    case $rel in /*) prof=$rel ;; *) prof=$base/$rel ;; esac
    [ -f "$prof/prefs.js" ] || [ -f "$prof/times.json" ] || continue   # a real, used profile
    mkdir -p "$prof/chrome"
    ln -sfn "$src/chrome/userChrome.css" "$prof/chrome/userChrome.css"
    ln -sfn "$src/chrome/userContent.css" "$prof/chrome/userContent.css"
    ln -sfn "$src/user.js" "$prof/user.js"
    echo "linked  $prof"
    n=$((n + 1))
  done < <(awk -F= '$1=="Path"{print $2}' "$ini")
done
if (( n == 0 )); then
  echo "No Firefox profile found. Start Firefox once, close it, then run this again." >&2
  exit 1
fi
echo "Done. Start Firefox; about:support shows the profile it uses under Profile Directory."
