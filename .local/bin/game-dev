#!/usr/bin/env bash
# Game-plan shortcuts. No project creation, uploads, or automatic commits.
# game-dev [plan|pico|picotron|godot|art|audio|sfx|code [directory]|capture|site|check]
set -euo pipefail
need() {
  command -v "$1" >/dev/null && return 0
  printf 'Missing command: %s. See docs/desktop-rebuild.md.\n' "$1" >&2
  if command -v notify-send >/dev/null; then
    notify-send -a 'Game dev' 'Tool not installed' "$1 — see docs/desktop-rebuild.md" || true
  fi
  return 1
}
case ${1:-} in
  plan)
    for dir in "${GUIDES_DIR:-$HOME/code/guides}" /workspace/guides; do
      if [ -f "$dir/gamedev/plan.md" ]; then
        need kitty; need less
        exec kitty --title 'Game plan' -e less -- "$dir/gamedev/plan.md"
      fi
    done
    printf 'Set GUIDES_DIR to your guides checkout, or clone sh0ds/guides to ~/code/guides.\n' >&2
    exit 1
    ;;
  pico) need pico8; exec pico8 ;;
  picotron) need picotron; exec picotron ;;
  godot) need godot; exec godot --project-manager ;;
  art)
    if command -v pixelorama >/dev/null; then exec pixelorama; fi
    if command -v aseprite >/dev/null; then exec aseprite; fi
    need pixelorama
    ;;
  audio)
    daw=${GAME_DAW:-pico8}
    need "$daw"; exec "$daw"
    ;;
  sfx) need xdg-open; exec xdg-open https://sfbgames.itch.io/chiptone/ ;;
  code)
    need zeditor
    project=${2:-$HOME/code}
    [ -d "$project" ] || { printf 'No directory: %s\n' "$project" >&2; exit 1; }
    exec zeditor -- "$project"
    ;;
  capture) need rec-toggle; exec rec-toggle ;;
  site) need zeditor; exec zeditor -- "${SITE_REPO:-$HOME/code/website}" ;;
  check)
    missing=0
    for tool in pico8 picotron godot pixelorama zeditor cc make gdb pkg-config lua lua-language-server clangd emcc ffmpeg; do
      if command -v "$tool" >/dev/null; then printf 'OK    %s\n' "$tool"; else printf 'MISS  %s\n' "$tool"; missing=1; fi
    done
    for path in "${PICO8_DIR:-$HOME/.local/opt/pico-8}" "${PICOTRON_DIR:-$HOME/.local/opt/picotron}"; do
      if [ -d "$path" ]; then printf 'FOUND %s\n' "$path"; else printf 'MISS  %s (licensed download)\n' "$path"; missing=1; fi
    done
    exit "$missing"
    ;;
  *) printf 'Usage: game-dev [plan|pico|picotron|godot|art|audio|sfx|code [directory]|capture|site|check]\n' >&2; exit 2 ;;
esac
