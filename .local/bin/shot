#!/usr/bin/env bash
# shot: screenshot a region, framed in Diag for devlogs and posts (ALT+Print).
# Asks for a caption (Escape or empty: date only), then saves
# ~/Pictures/shot-DATE.png and copies it. The frame: black margin, a 2 px
# rule around the picture, and a caption row with a blue marker, your
# caption on the left and the date and sh0ds.dev on the right.
set -euo pipefail
geom=$(slurp) || exit 0
raw=$(mktemp --suffix=.png)
trap 'rm -f "$raw"' EXIT
grim -g "$geom" "$raw"
title=$(fuzzel --dmenu --prompt-only 'caption: ' </dev/null) || title=""
out=~/Pictures/shot-$(date +%Y%m%d-%H%M%S).png
mkdir -p ~/Pictures
font=$(fc-match -f '%{file}' 'Terminess Nerd Font Mono')
im=magick; command -v magick >/dev/null || im=convert
w=$("$im" identify -format %w "$raw" 2>/dev/null || identify -format %w "$raw")
W=$((w + 52))
"$im" "$raw" -bordercolor '#3f4650' -border 2 -bordercolor '#000000' -border 24 \
  \( -size "${W}x60" xc:'#000000' \
     -fill '#3f4650' -draw "rectangle 26,0 $((W - 27)),0" \
     -fill '#1793d1' -draw "rectangle 26,25 33,32" \
     -font "$font" -pointsize 20 -gravity west \
     -fill '#e6e8ea' -annotate +42+0 "$title" \
     -gravity east -fill '#8a929c' -annotate +26+0 "$(date +%F) · sh0ds.dev" \) \
  -gravity center -append "$out"
wl-copy <"$out"
notify-send -a shot "Screenshot framed" "$out"
