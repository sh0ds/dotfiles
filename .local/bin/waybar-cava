#!/usr/bin/env bash
# waybar-cava: live audio bars for waybar's custom/cava module.
# Arch's waybar is built without the native cava module, so this runs cava
# with raw ASCII output and turns each frame (0-7 per bar) into ▁▂▃▄▅▆▇█.
set -euo pipefail

bars=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
dict="s/;//g"
for i in "${!bars[@]}"; do
  dict+=";s/$i/${bars[$i]}/g"
done

conf=$(mktemp -t waybar-cava.XXXXXX)
trap 'rm -f "$conf"' EXIT

cat >"$conf" <<EOF
[general]
bars = 12
framerate = 60
sleep_timer = 5

[input]
method = pipewire

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7

[smoothing]
; Monstercat smoothing: neighbouring bars flow into each other instead of jittering
monstercat = 1
noise_reduction = 77
EOF

cava -p "$conf" | sed -u "$dict"
