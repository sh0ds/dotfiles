#!/usr/bin/env bash
# app: one key per app.
#   app CLASS-REGEX COMMAND...           jump to its window wherever it is,
#                                        start it tiled here if it isn't open,
#                                        jump back if you're already on it
#   app --toggle CLASS-REGEX COMMAND...  the same, but pressing the key on the
#                                        app hides it, and the next press brings
#                                        it back tiled on the workspace you're on
# Hidden windows wait on special:hidden, which has no key and isn't in the bar.
# Hiding and bringing back skip the animation: the window would otherwise
# fly towards the full-screen tile it gets on the hidden workspace, stretched,
# while the windows left behind re-tile (the "glitch" on Super+S).
# notes and djvm jump; chat, music, sysmon and SoundCloud
# (SUPER+S in rice.lua) toggle.
set -euo pipefail
toggle=0
[ "${1:-}" = --toggle ] && { toggle=1; shift; }
re=$1
shift
d() { hyprctl dispatch "$1" >/dev/null; }
still() { d "hl.dsp.window.set_prop({ prop = \"no_anim\", value = \"$2\", window = \"address:$1\" })"; }

active=$(hyprctl activewindow -j | jq -r '.class // empty')
if [ -n "$active" ] && jq -en --arg c "$active" --arg re "$re" '$c | test($re)' >/dev/null; then
  if (( toggle )); then
    addr=$(hyprctl activewindow -j | jq -r '.address')
    still "$addr" 1
    d "hl.dsp.window.move({ workspace = \"special:hidden\", follow = false, window = \"address:$addr\" })"
  else
    d 'hl.dsp.focus({ last = true })'
  fi
  exit 0
fi

read -r addr ws < <(hyprctl clients -j | jq -r --arg re "$re" \
  '[.[] | select(.class | test($re))][0] // empty | "\(.address) \(.workspace.name)"') || true
if [ -n "${addr:-}" ]; then
  if [ "$ws" = special:hidden ]; then
    here=$(hyprctl activeworkspace -j | jq -r '.id')
    d "hl.dsp.window.move({ workspace = \"$here\", window = \"address:$addr\" })"
    # Back to normal animations once it has landed.
    (sleep 0.4; still "$addr" unset) >/dev/null 2>&1 &
  fi
  d "hl.dsp.focus({ window = \"address:$addr\" })"
  exit 0
fi
"$@" >/dev/null 2>&1 & disown
