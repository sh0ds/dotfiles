{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "p8",
  "rules": {
    "cart": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_body"
              },
              "named": true,
              "value": "header"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "lua_section"
              },
              {
                "type": "SYMBOL",
                "name": "data_section"
              }
            ]
          }
        }
      ]
    },
    "lua_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "lua_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_body"
              },
              "named": true,
              "value": "lua_code"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "data_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_body"
              },
              "named": true,
              "value": "data"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "lua_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "__lua__[ \\t]*\\r?\\n?"
        }
      }
    },
    "section_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "__[a-z0-9]+__[ \\t]*\\r?\\n?"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_body"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}