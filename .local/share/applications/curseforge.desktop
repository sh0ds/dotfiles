[Desktop Entry]
Type=Application
Name=CurseForge
GenericName=Addon Manager
Comment=Addons for WoW Forever in the Battle.net prefix (the first start sets it up)
Exec=curseforge %U
Icon=applications-games
Terminal=false
Categories=Game;
Keywords=wow;addons;curse;warcraft;
MimeType=x-scheme-handler/curseforge;x-scheme-handler/cfauth;x-scheme-handler/curseforge-checkout;
StartupWMClass=CurseForge
