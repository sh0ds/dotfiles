{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.2",
  "runtime.nonstandardSymbol": ["+=", "-=", "*=", "/=", "%=", "^=", "|=", "&=", "<<=", ">>=", "!=", "//"],
  "runtime.unicodeName": true,
  "runtime.builtin": {
    "basic": "disable", "bit": "disable", "bit32": "disable", "coroutine": "disable",
    "debug": "disable", "ffi": "disable", "io": "disable", "jit": "disable",
    "math": "disable", "os": "disable", "package": "disable", "string": "disable",
    "table": "disable", "utf8": "disable"
  },
  "workspace.library": ["@HOME@/.local/share/fantasy-lua/pico8"],
  "workspace.checkThirdParty": false,
  "diagnostics.disable": ["lowercase-global"]
}
