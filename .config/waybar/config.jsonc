// ~/.config/waybar/config.jsonc  (Diag: one diagnostic line along the bottom)
{
  "layer": "top",
  "position": "bottom",
  "height": 34,
  "spacing": 0,

  // Left: workspaces and what's playing. Middle: LIVE and REC, only while
  // active. Right: "stats" (click it: cpu, mem, temp, gpu and network slide
  // out, click again to hide them, so nothing ticks away all day), then the
  // Pi, volume, notifications, the clock and the power button.
  // Like the diagnostic lines on sh0ds.dev: every module is "key: value",
  // the key in Arch blue, the value in white. No icons, no pills.
  "modules-left": ["hyprland/workspaces", "mpris"],
  "modules-center": ["custom/live", "custom/rec"],
  "modules-right": ["tray", "group/stats", "custom/pi", "pulseaudio", "custom/notification", "clock", "custom/power"],

  "group/stats": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 150, "transition-left-to-right": false, "click-to-reveal": true, "children-class": "stat" },
    "modules": ["custom/stats", "cpu", "memory", "temperature", "custom/gpu", "network"]
  },
  // The drawer's handle. Click: show or hide the readings. Right-click: btop.
  "custom/stats": {
    "format": "<span color='#1793d1'>stats</span>",
    "tooltip": false,
    "on-click-right": "~/.local/bin/sysmon"
  },

  // Numbers. The current one is a blue block, empty ones are dim, one that
  // wants attention is underlined red.
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": { "DP-4": [1, 2, 3, 4, 5] },   // 1-5 always on the main screen, even when empty
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  "clock": {
    "format": "<span color='#1793d1'>time:</span> {:%Y-%m-%d %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "~/.local/bin/calendar",
    // Hover: month calendar with week numbers. Scroll changes month,
    // right-click switches to the whole year, click opens Proton Calendar.
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#f4f6f8'><b>{}</b></span>",
        "days":     "<span color='#c4c9ce'>{}</span>",
        "weeks":    "<span color='#5d6670'>W{}</span>",
        "weekdays": "<span color='#8a929c'>{}</span>",
        "today":    "<span color='#1793d1'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Unread count from swaync; click opens the notification centre.
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "<span color='#1793d1'>msg:</span>",
      "none": "<span color='#5d6670'>msg:</span>",
      "dnd-notification": "<span color='#1793d1'>dnd:</span>",
      "dnd-none": "<span color='#5d6670'>dnd:</span>"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // "pi: up" when the Pi answers a ping, "pi: down" in red when not. Click to ssh in.
  "custom/pi": {
    "exec": "~/.local/bin/pi-status",
    "return-type": "json",
    "interval": 30,
    "on-click": "kitty -e ssh pi"
  },

  "cpu": { "format": "<span color='#1793d1'>cpu:</span>{usage:>3}%", "interval": 5, "on-click": "~/.local/bin/sysmon" },
  "memory": { "format": "<span color='#1793d1'>mem:</span> {used:0.1f}G", "interval": 10, "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB", "on-click": "~/.local/bin/sysmon" },
  // CPU package temperature. coretemp is Intel's sensor; on AMD use k10temp.
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "<span color='#1793d1'>temp:</span>{temperatureC:>3}°C",
    "interval": 5,
    "on-click": "~/.local/bin/sysmon"
  },
  "custom/gpu": {
    "exec": "~/.local/bin/gpu-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/sysmon"
  },
  // The volume keys show the swayosd popup.
  "pulseaudio": {
    "format": "<span color='#1793d1'>vol:</span>{volume:>4}",
    "format-muted": "<span color='#1793d1'>vol:</span> mute",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },
  "network": {
    "format-wifi": "<span color='#1793d1'>wifi:</span> {signalStrength}% ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-ethernet": "<span color='#1793d1'>eth:</span> ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "interval": 2,
    "format-disconnected": "<span color='#1793d1'>net:</span> down",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    // Click: Wi-Fi picker in fuzzel. Right-click: nmtui for everything else.
    "on-click": "~/.local/bin/wifi",
    "on-click-right": "~/.local/bin/wifi settings"
  },
  "tray": { "spacing": 6, "icon-size": 14 },

  // Now playing (SoundCloud app, Firefox, mpv, mpd). Fixed length so nothing shifts.
  "mpris": {
    "format": "<span color='#1793d1'>play:</span> {artist} - {title}",
    "format-paused": "<span color='#5d6670'>hold:</span> {artist} - {title}",
    "artist-len": 20,
    "title-len": 30,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  // LIVE while the screen is shared (Discord, OBS, Firefox); also turns on
  // do-not-disturb for the duration. Hidden otherwise.
  "custom/live": {
    "exec": "~/.local/bin/live-status",
    "return-type": "json",
    "restart-interval": 5
  },
  // REC while rec-toggle (SUPER+SHIFT+R) is recording; hidden otherwise.
  "custom/rec": {
    "exec": "~/.local/bin/rec-status",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.local/bin/rec-toggle"
  },
  "custom/power": {
    "format": "halt",
    "on-click": "wlogout -b 5",
    "tooltip": false
  }
}
