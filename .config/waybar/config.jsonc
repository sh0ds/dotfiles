// Diag instrument rail: workspaces/media · time · system controls.
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,

  "fixed-center": true,
  "modules-left": ["hyprland/workspaces", "custom/live", "custom/rec", "mpris"],
  "modules-center": ["clock"],
  "modules-right": ["custom/stats", "custom/pi", "pulseaudio", "custom/notification", "tray", "custom/power"],

  // Closed it reads "sys"; click it and the same spot shows cpu,
  // mem and temp (bar-stats); GPU and network stay in its tooltip so the
  // clock and media controls still fit. Click again to close. Right-click: btop.
  "custom/stats": {
    "exec": "~/.local/bin/bar-stats",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "on-click": "~/.local/bin/bar-stats toggle",
    "on-click-right": "~/.local/bin/sysmon"
  },

  // Numbered workspaces; blue underline for focus, amber for urgency.
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": { "DP-4": [1, 2, 3, 4, 5] },   // 1-5 always on the main screen, even when empty
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A · %Y-%m-%d}\n<tt><small>{calendar}</small></tt>",
    // Hover: month calendar with week numbers. Scroll changes month,
    // click switches month/year; the clock never launches an external app.
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#f4f6f8'><b>{}</b></span>",
        "days":     "<span color='#c4c9ce'>{}</span>",
        "weeks":    "<span color='#5d6670'>W{}</span>",
        "weekdays": "<span color='#8a929c'>{}</span>",
        "today":    "<span color='#1793d1'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-left": "mode",
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Unread count from swaync; click opens the notification centre.
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "<span color='#1793d1'>msg</span>",
      "none": "<span color='#5d6670'>msg</span>",
      "dnd-notification": "<span color='#1793d1'>dnd</span>",
      "dnd-none": "<span color='#5d6670'>dnd</span>"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // "pi: up" when the Pi answers a ping, "pi: down" in red when not. Click to ssh in.
  "custom/pi": {
    "exec": "~/.local/bin/pi-status",
    "return-type": "json",
    "interval": 30,
    "on-click": "kitty -e ssh pi"
  },

  // The volume keys show the swayosd popup.
  "pulseaudio": {
    "format": "vol {volume:>3}%",
    "format-muted": "vol mute",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },
  "tray": { "spacing": 6, "icon-size": 14 },

  // Bound media width: long titles must not push the clock off smaller screens.
  "mpris": {
    "format": "<span color='#1793d1'>play</span>  {artist} / {title}",
    "format-paused": "<span color='#5d6670'>hold</span>  {artist} / {title}",
    "artist-len": 10,
    "title-len": 20,
    "max-length": 28,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  // LIVE while the screen is shared (Discord, OBS, Firefox); also turns on
  // do-not-disturb for the duration. Hidden otherwise.
  "custom/live": {
    "exec": "~/.local/bin/live-status",
    "return-type": "json",
    "restart-interval": 5
  },
  // REC while rec-toggle (SUPER+SHIFT+R) is recording; hidden otherwise.
  "custom/rec": {
    "exec": "~/.local/bin/rec-status",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.local/bin/rec-toggle"
  },
  "custom/power": {
    "format": "[exit]",
    "on-click": "power-menu",
    "tooltip": false
  }
}
