// ~/.config/waybar/config.jsonc  (Amethyst: one line of text along the bottom)
{
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "spacing": 0,

  // Left: workspaces and what's playing. Middle: LIVE and REC, only while
  // active. Right: plain readings, then the clock and the power button.
  // No icons, no pills: every module is a word and a number.
  "modules-left": ["hyprland/workspaces", "mpris"],
  "modules-center": ["custom/live", "custom/rec"],
  "modules-right": ["tray", "cpu", "memory", "temperature", "custom/gpu", "custom/pi", "pulseaudio", "network", "custom/notification", "clock", "custom/power"],

  // Numbers. The current one is a violet block, empty ones are dim, one that
  // wants attention is underlined red.
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": { "*": 5 },   // 1-5 always visible, even when empty
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "~/.local/bin/calendar",
    // Hover: month calendar with week numbers. Scroll changes month,
    // right-click switches to the whole year, click opens Proton Calendar.
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ece4fb'><b>{}</b></span>",
        "days":     "<span color='#b0a6c4'>{}</span>",
        "weeks":    "<span color='#5e5270'>W{}</span>",
        "weekdays": "<span color='#7f7494'>{}</span>",
        "today":    "<span color='#b06cff'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Unread count from swaync; click opens the notification centre.
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "<span foreground='#b06cff'>msg</span>",
      "none": "msg",
      "dnd-notification": "<span foreground='#b06cff'>dnd</span>",
      "dnd-none": "dnd"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // "pi up" in violet when the Pi answers a ping, "pi down" when not. Click to ssh in.
  "custom/pi": {
    "exec": "~/.local/bin/pi-status",
    "return-type": "json",
    "interval": 30,
    "on-click": "kitty -e ssh pi"
  },

  "cpu": { "format": "cpu {usage:>2}%", "interval": 5, "on-click": "~/.local/bin/sysmon" },
  "memory": { "format": "mem {used:0.1f}G", "interval": 10, "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB", "on-click": "~/.local/bin/sysmon" },
  // CPU package temperature. coretemp is Intel's sensor; on AMD use k10temp.
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC:>2}°C",
    "interval": 5,
    "on-click": "~/.local/bin/sysmon"
  },
  "custom/gpu": {
    "exec": "~/.local/bin/gpu-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/sysmon"
  },
  // The volume keys show the swayosd popup.
  "pulseaudio": {
    "format": "vol {volume:>3}",
    "format-muted": "vol mute",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },
  "network": {
    "format-wifi": "wifi {signalStrength}% ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-ethernet": "eth ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "interval": 2,
    "format-disconnected": "net down",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    // Click: Wi-Fi picker in fuzzel. Right-click: nmtui for everything else.
    "on-click": "~/.local/bin/wifi",
    "on-click-right": "~/.local/bin/wifi settings"
  },
  "tray": { "spacing": 6, "icon-size": 14 },

  // Now playing (SoundCloud app, Firefox, mpv, mpd). Fixed length so nothing shifts.
  "mpris": {
    "format": "{artist} - {title}",
    "format-paused": "{artist} - {title} (paused)",
    "artist-len": 20,
    "title-len": 30,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  // LIVE while the screen is shared (Discord, OBS, Firefox); also turns on
  // do-not-disturb for the duration. Hidden otherwise.
  "custom/live": {
    "exec": "~/.local/bin/live-status",
    "return-type": "json",
    "restart-interval": 5
  },
  // REC while rec-toggle (SUPER+SHIFT+R) is recording; hidden otherwise.
  "custom/rec": {
    "exec": "~/.local/bin/rec-status",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.local/bin/rec-toggle"
  },
  "custom/power": {
    "format": "off",
    "on-click": "wlogout -b 5",
    "tooltip": false
  }
}
