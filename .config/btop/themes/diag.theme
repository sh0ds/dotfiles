# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#e6e8ea"

# Title color for boxes
theme[title]="#e6e8ea"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#1793d1"

# Background color of selected item in processes box
theme[selected_bg]="#0e3d5c"

# Foreground color of selected item in processes box
theme[selected_fg]="#e6e8ea"

# Color of inactive/disabled text
theme[inactive_fg]="#8a929c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f4f6f8"

# Background color of the percentage meters
theme[meter_bg]="#2e353d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f4f6f8"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#3f4650"
theme[mem_box]="#3f4650"
theme[net_box]="#3f4650"
theme[proc_box]="#3f4650"

# Box divider line and small boxes line color
theme[div_line]="#3f4650"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#75c94d"
theme[temp_mid]="#ffb000"
theme[temp_end]="#e5484d"

# CPU graph: solid Arch blue
theme[cpu_start]="#1793d1"
theme[cpu_mid]="#1793d1"
theme[cpu_end]="#1793d1"

# Mem/Disk free meter
theme[free_start]="#1793d1"
theme[free_mid]="#1793d1"
theme[free_end]="#1793d1"

# Mem/Disk cached meter
theme[cached_start]="#1793d1"
theme[cached_mid]="#1793d1"
theme[cached_end]="#1793d1"

# Mem/Disk available meter
theme[available_start]="#1793d1"
theme[available_mid]="#ffb000"
theme[available_end]="#e5484d"

# Mem/Disk used meter
theme[used_start]="#1793d1"
theme[used_mid]="#1793d1"
theme[used_end]="#1793d1"

# Download graph
theme[download_start]="#1793d1"
theme[download_mid]="#1793d1"
theme[download_end]="#1793d1"

# Upload graph
theme[upload_start]="#1793d1"
theme[upload_mid]="#1793d1"
theme[upload_end]="#1793d1"

# Process graph
theme[process_start]="#1793d1"
theme[process_mid]="#1793d1"
theme[process_end]="#1793d1"
