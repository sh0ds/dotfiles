// Amethyst for rmpc (recoloured from catppuccin/rmpc). Only colours and icons, the layout is rmpc's own
// (album art left, queue right).
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    text_color: "#c9c0db",
    preview_label_style: (fg: "#d9b77a"),
    preview_metadata_group_style: (fg: "#b06cff", modifiers: "Bold"),
    highlighted_item_style: (fg: "#b06cff", modifiers: "Bold"),
    current_item_style: (fg: "#000000", bg: "#9a8cff", modifiers: "Bold"),
    borders_style: (fg: "#2b2238"),
    highlight_border_style: (fg: "#9a8cff"),
    symbols: (
        song: "󰎈",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
    ),
    progress_bar: (
        symbols: ["━", "━", "●", "━", "━"],
        track_style: (fg: "#1a1424"),
        elapsed_style: (fg: "#b06cff"),
        thumb_style: (fg: "#b06cff"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#1a1424"),
        ends_style: (fg: "#2b2238"),
        thumb_style: (fg: "#9a8cff"),
    ),
    tab_bar: (
        active_style: (fg: "#000000", bg: "#b06cff", modifiers: "Bold"),
        inactive_style: (fg: "#9a90ae"),
    ),
)
