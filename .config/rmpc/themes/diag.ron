// Afterhours for rmpc (recoloured from catppuccin/rmpc). Only colours and icons, the layout is rmpc's own
// (album art left, queue right).
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    text_color: "#e0dde8",
    preview_label_style: (fg: "#948fa3"),
    preview_metadata_group_style: (fg: "#b49cf0", modifiers: "Bold"),
    highlighted_item_style: (fg: "#b49cf0", modifiers: "Bold"),
    current_item_style: (fg: "#0d0c10", bg: "#b49cf0", modifiers: "Bold"),
    borders_style: (fg: "#35323f"),
    highlight_border_style: (fg: "#b49cf0"),
    symbols: (
        song: "󰎈",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
    ),
    progress_bar: (
        symbols: ["─", "─", "█", "─", "─"],
        track_style: (fg: "#1b1a22"),
        elapsed_style: (fg: "#b49cf0"),
        thumb_style: (fg: "#b49cf0"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#1b1a22"),
        ends_style: (fg: "#25232d"),
        thumb_style: (fg: "#b49cf0"),
    ),
    tab_bar: (
        active_style: (fg: "#b49cf0", bg: "#131218", modifiers: "Bold"),
        inactive_style: (fg: "#aaa5b8"),
    ),
)
