// Afterhours for rmpc (recoloured from catppuccin/rmpc). Only colours and icons, the layout is rmpc's own
// (album art left, queue right).
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    text_color: "#dfe3d8",
    preview_label_style: (fg: "#929c8a"),
    preview_metadata_group_style: (fg: "#b4c97f", modifiers: "Bold"),
    highlighted_item_style: (fg: "#b4c97f", modifiers: "Bold"),
    current_item_style: (fg: "#0c0d0b", bg: "#b4c97f", modifiers: "Bold"),
    borders_style: (fg: "#343c31"),
    highlight_border_style: (fg: "#b4c97f"),
    symbols: (
        song: "󰎈",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
    ),
    progress_bar: (
        symbols: ["─", "─", "█", "─", "─"],
        track_style: (fg: "#1a1e19"),
        elapsed_style: (fg: "#b4c97f"),
        thumb_style: (fg: "#b4c97f"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#1a1e19"),
        ends_style: (fg: "#242a23"),
        thumb_style: (fg: "#b4c97f"),
    ),
    tab_bar: (
        active_style: (fg: "#b4c97f", bg: "#121411", modifiers: "Bold"),
        inactive_style: (fg: "#a9b2a1"),
    ),
)
