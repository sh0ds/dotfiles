// Diag for rmpc (recoloured from catppuccin/rmpc). Only colours and icons, the layout is rmpc's own
// (album art left, queue right).
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    text_color: "#ecf0e5",
    preview_label_style: (fg: "#aab5a2"),
    preview_metadata_group_style: (fg: "#c6db91", modifiers: "Bold"),
    highlighted_item_style: (fg: "#c6db91", modifiers: "Bold"),
    current_item_style: (fg: "#141613", bg: "#c6db91", modifiers: "Bold"),
    borders_style: (fg: "#485344"),
    highlight_border_style: (fg: "#c6db91"),
    symbols: (
        song: "󰎈",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
    ),
    progress_bar: (
        symbols: ["─", "─", "█", "─", "─"],
        track_style: (fg: "#272d26"),
        elapsed_style: (fg: "#c6db91"),
        thumb_style: (fg: "#c6db91"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#272d26"),
        ends_style: (fg: "#333c32"),
        thumb_style: (fg: "#c6db91"),
    ),
    tab_bar: (
        active_style: (fg: "#c6db91", bg: "#1c201c", modifiers: "Bold"),
        inactive_style: (fg: "#bdc7b5"),
    ),
)
