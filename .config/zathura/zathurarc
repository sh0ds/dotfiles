# ~/.config/zathura/zathurarc: PDFs. Vim keys, dark pages (CTRL+R flips back
# to the original colours), selected text goes to the normal clipboard.
set selection-clipboard clipboard
set adjust-open width
set font "JetBrainsMono Nerd Font 10"

# Afterhours (colours on the layout of catppuccin/zathura)
set default-fg                rgba(223,227,216,1)
set default-bg                rgba(12,13,11,1)

set completion-bg             rgba(26,30,25,1)
set completion-fg             rgba(223,227,216,1)
set completion-highlight-bg   rgba(180,156,240,1)
set completion-highlight-fg   rgba(12,13,11,1)
set completion-group-bg       rgba(18,20,17,1)
set completion-group-fg       rgba(223,227,216,1)

set statusbar-fg              rgba(223,227,216,1)
set statusbar-bg              rgba(12,13,11,1)
set inputbar-fg               rgba(223,227,216,1)
set inputbar-bg               rgba(12,13,11,1)

set notification-bg           rgba(12,13,11,1)
set notification-fg           rgba(223,227,216,1)
set notification-error-bg     rgba(12,13,11,1)
set notification-error-fg     rgba(217,120,108,1)
set notification-warning-bg   rgba(12,13,11,1)
set notification-warning-fg   rgba(217,159,102,1)

set recolor                   "true"
set recolor-lightcolor        rgba(12,13,11,1)
set recolor-darkcolor         rgba(223,227,216,1)

set index-fg                  rgba(223,227,216,1)
set index-bg                  rgba(12,13,11,1)
set index-active-fg           rgba(223,227,216,1)
set index-active-bg           rgba(26,30,25,1)

set render-loading-bg         rgba(12,13,11,1)
set render-loading-fg         rgba(223,227,216,1)

set highlight-color           rgba(138,146,156,0.3)
set highlight-fg              rgba(223,227,216,1)
set highlight-active-color    rgba(180,156,240,0.3)
