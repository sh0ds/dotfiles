{
  "label": "lock",
  "action": "loginctl lock-session",
  "text": "01  LOCK SESSION       [L]",
  "keybind": "l"
}
{
  "label": "logout",
  "action": "power logout",
  "text": "02  END SESSION        [E]",
  "keybind": "e"
}
{
  "label": "suspend",
  "action": "systemctl suspend",
  "text": "03  SUSPEND            [U]",
  "keybind": "u"
}
{
  "label": "reboot",
  "action": "power reboot",
  "text": "04  REBOOT             [R]",
  "keybind": "r"
}
{
  "label": "shutdown",
  "action": "power poweroff",
  "text": "05  POWER OFF          [S]",
  "keybind": "s"
}
