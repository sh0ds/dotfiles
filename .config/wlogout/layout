{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "sh -c 'djvm off; hyprctl dispatch \"hl.dsp.exit()\"'",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "sh -c 'djvm off; systemctl reboot'",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "sh -c 'djvm off; systemctl poweroff'",
    "text" : "Shutdown",
    "keybind" : "s"
}
