// ~/.config/zed/tasks.json: tasks for every project. Run one with
// alt+shift+t, or the keys in keymap.json.
[
  {
    // F5: rerun the PICO-8 or Picotron cart this file belongs to (cart-run).
    "label": "cart: run",
    "command": "cart-run",
    "args": ["$ZED_FILE"],
    // Saves first: PICO-8 reads the cart from disk, so an unsaved edit
    // would rerun the old code and F5 would look dead.
    "save": "all",
    "reveal": "never",
    "allow_concurrent_runs": false
  },
  {
    // ctrl+alt+n: a new cart next to this file (cart-new asks for the name).
    "label": "cart: new",
    "command": "cart-new",
    "args": ["--in", "${ZED_DIRNAME:.}"], // . = the project folder when no file is open
    "reveal": "never",
    "hide": "on_success",
    "allow_concurrent_runs": false
  },
  {
    // F7: how many of PICO-8's 8192 tokens the cart uses (p8tokens).
    "label": "cart: tokens",
    "command": "p8tokens",
    "args": ["$ZED_FILE"],
    "save": "all",
    "reveal": "no_focus",
    "hide": "never"
  }
]
