// ~/.config/zed/settings.json: Zed in Afterhours. install-dotfiles.sh copies this
// file instead of linking it, because Zed rewrites it when you change a
// setting in its UI. Edit it here and rerun the installer, or copy your UI
// changes back into the repo.
{
  "theme": { "mode": "dark", "dark": "Diag", "light": "Diag" },
  "icon_theme": "Zed (Default)",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 14,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_line_height": "standard",

  // Quiet: no blinking, no scrollbars, no minimap, no AI.
  "cursor_blink": false,
  "scrollbar": { "show": "never" },
  "minimap": { "show": "never" },
  "disable_ai": true,
  "features": { "edit_prediction_provider": "none" },
  "collaboration_panel": { "button": false },
  "notification_panel": { "button": false },
  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_update": false, // pacman updates it

  // Same habits as the terminal editor.
  "relative_line_numbers": true,
  "vertical_scroll_margin": 8,
  "show_wrap_guides": true,
  "wrap_guides": [100],
  "current_line_highlight": "line",
  "inlay_hints": { "enabled": true }, // Types and diagnostics inline
  "toolbar": { "breadcrumbs": true, "quick_actions": false },
  "tab_bar": { "show_nav_history_buttons": false },
  // Files on the right, git and the outline on the left. Set here because
  // install-dotfiles.sh copies this file over whatever the UI saved.
  "project_panel": { "dock": "right", "git_status": true },
  "git_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "blinking": "off",
    "shell": "system"
  },

  // Game plan: Lua, typed GDScript, C and the web. Existing optional
  // language overrides remain available for older projects.
  "auto_install_extensions": {
    "gdscript": true,
    "html": true,
    "lua": true,
    "toml": true,
    "make": true
  },
  // A cart is Lua between a header and the art data. Zed colours it as Lua,
  // and in ~/code/pico8 the language server reads the header and the data
  // as comments (pico8-plugin.lua), so whole carts open without errors.
  "file_types": { "Lua": ["p8"] },
  "languages": {
    "Erlang": { "language_servers": ["elp", "!erlang-ls", "..."] },
    // The Lua formatter doesn't know PICO-8's += and != and would mangle
    // them, so Lua is only formatted when you ask (ctrl+shift+i).
    "Lua": { "format_on_save": "off" }
  }
}
