# Diag for aerc: aerc's own catppuccin styleset with the Diag
# colours swapped in. No backgrounds, so kitty's black shows through.

*.default=true
*.normal=true

default.fg=#e6e8ea

error.fg=#e5484d
warning.fg=#ffb000
success.fg=#75c94d

tab.fg=#8a929c
tab.bg=#0d1014
tab.selected.fg=#000000
tab.selected.bg=#1793d1
tab.selected.bold=true

border.fg=#3f4650
border.bold=true

msglist_unread.bold=true
msglist_flagged.fg=#ffb000
msglist_flagged.bold=true
msglist_result.fg=#4aa3df
msglist_result.bold=true
msglist_*.selected.bold=true
msglist_*.selected.bg=#0e3d5c

dirlist_*.selected.bold=true
dirlist_*.selected.bg=#0e3d5c

statusline_default.fg=#8a929c
statusline_default.bg=#161a1f
statusline_error.bold=true
statusline_success.bold=true

completion_default.selected.bg=#0e3d5c

part_filename.selected.fg=#e6e8ea
part_filename.selected.bg=#000000
part_switcher.selected.bg=#000000

part_mimetype.selected.fg=#e6e8ea
part_mimetype.selected.bg=#000000

selector_focused.bg=#000000

[viewer]
url.fg=#4aa3df
url.underline=true
header.bold=true
signature.dim=true
diff_meta.bold=true
diff_chunk.fg=#4aa3df
diff_chunk_func.fg=#4aa3df
diff_chunk_func.bold=true
diff_add.fg=#75c94d
diff_del.fg=#e5484d
diff_whitespace.bg=#e5484d
quote_*.fg=#5d6670
quote_1.fg=#8a929c
