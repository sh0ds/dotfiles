# Amethyst for aerc: aerc's own catppuccin styleset with the Amethyst
# colours swapped in. No backgrounds, so kitty's black shows through.

*.default=true
*.normal=true

default.fg=#c9c0db

error.fg=#e0607a
warning.fg=#d99a6c
success.fg=#9fbf8a

tab.fg=#5e5270
tab.bg=#0b0910
tab.selected.fg=#c9c0db
tab.selected.bg=#000000
tab.selected.bold=true

border.fg=#000000
border.bold=true

msglist_unread.bold=true
msglist_flagged.fg=#d9b77a
msglist_flagged.bold=true
msglist_result.fg=#9a8cff
msglist_result.bold=true
msglist_*.selected.bold=true
msglist_*.selected.bg=#1a1424

dirlist_*.selected.bold=true
dirlist_*.selected.bg=#1a1424

statusline_default.fg=#7f7494
statusline_default.bg=#1a1424
statusline_error.bold=true
statusline_success.bold=true

completion_default.selected.bg=#1a1424

part_filename.selected.fg=#c9c0db
part_filename.selected.bg=#000000
part_switcher.selected.bg=#000000

part_mimetype.selected.fg=#c9c0db
part_mimetype.selected.bg=#000000

selector_focused.bg=#000000

[viewer]
url.fg=#9a8cff
url.underline=true
header.bold=true
signature.dim=true
diff_meta.bold=true
diff_chunk.fg=#9a8cff
diff_chunk_func.fg=#9a8cff
diff_chunk_func.bold=true
diff_add.fg=#9fbf8a
diff_del.fg=#e0607a
diff_whitespace.bg=#e0607a
quote_*.fg=#5e5270
quote_1.fg=#7f7494
