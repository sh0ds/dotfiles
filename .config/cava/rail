# cava for the Afterhours rail: ten bars as numbers 0-7 on stdout, one
# line per frame. The shell starts it only while something is playing.
# Stereo: bass in the middle, left and right channels mirrored outwards.
[general]
bars = 10
framerate = 30
sleep_timer = 1

[input]
method = pipewire

[output]
channels = stereo
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 77
