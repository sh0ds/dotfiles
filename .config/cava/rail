# cava for the Afterhours rail: eight bars as numbers 0-7 on stdout, one
# line per frame. The shell starts it only while something is playing.
[general]
bars = 8
framerate = 30
sleep_timer = 1

[input]
method = pipewire

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 66
