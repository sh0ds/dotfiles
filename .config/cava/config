## ~/.config/cava/config  (Catppuccin Mocha, PipeWire, Hyprland + kitty)

[general]
live-config = 1
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 5

[input]
method = pipewire
source = auto
active = 1
virtual = 1

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
synchronized_sync = 1
show_idle_bar_heads = 0

[color]
# background stays the terminal's, so kitty's transparency shows through
gradient = 1
gradient_color_1 = '#94e2d5'
gradient_color_2 = '#89dceb'
gradient_color_3 = '#74c7ec'
gradient_color_4 = '#89b4fa'
gradient_color_5 = '#b4befe'
gradient_color_6 = '#cba6f7'
gradient_color_7 = '#f5c2e7'
gradient_color_8 = '#f38ba8'

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77
