{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-width": 400,
  "notification-window-width": 384,
  "timeout": 6,
  "transition-time": 120,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "layer-shell-cover-screen": false,
  "relative-timestamps": true,
  "hide-on-clear": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "notifications:",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "dnd": {
      "text": "quiet:"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": false
    },
    "volume": {
      "label": "vol:",
      "show-per-app": false
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "wifi",
          "command": "wifi"
        },
        {
          "label": "night",
          "command": "nightlight",
          "type": "toggle",
          "update-command": "sh -c 'pgrep -x hyprsunset >/dev/null && echo true || echo false'"
        },
        {
          "label": "capture",
          "command": "sh -c 'swaync-client -cp; sleep 0.4; grim -g \"$(slurp)\" - | satty --filename - --copy-command wl-copy'"
        },
        {
          "label": "record",
          "command": "sh -c 'swaync-client -cp; rec-toggle'"
        },
        {
          "label": "calc",
          "command": "sh -c 'swaync-client -cp; calc'"
        },
        {
          "label": "term",
          "command": "sh -c 'swaync-client -cp; kitty'"
        },
        {
          "label": "lock",
          "command": "sh -c 'swaync-client -cp; loginctl lock-session'"
        },
        {
          "label": "halt",
          "command": "sh -c 'swaync-client -cp; power-menu'"
        }
      ]
    }
  },
  "notification-visibility": {
    "whatsapp-phone-copy": {
      "state": "ignored",
      "app-name": "(?i)^(KDE\\s*Connect|kdeconnect(d|\\.daemon)?)$",
      "summary": "(?i)^WhatsApp( Business)?$"
    }
  },
  "control-center-exclusive-zone": true
}
