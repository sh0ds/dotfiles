{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sh0ds.txt",
    // $1-$5 in sh0ds.txt: the letters, all violet. $6: the shadow edges, plum.
    "color": {
      "1": "#b06cff", "2": "#b06cff", "3": "#b06cff", "4": "#b06cff", "5": "#b06cff",
      "6": "#2b2238"
    },
    "padding": { "top": 3, "left": 1, "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "#7f7494", "title": "#ece4fb" } },
  "modules": [
    "title", "separator", "os", "kernel", "wm", "shell", "terminal", "packages", "uptime",
    { "type": "command", "key": "GHC", "text": "ghc --numeric-version" },
    "break", "colors"
  ]
}
