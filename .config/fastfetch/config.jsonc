{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Arch companion to the Pi greeting: identical logo and layout, Afterhours violet accents.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sh0ds.txt",
    "color": {
      "1": "38;2;180;156;240", "2": "38;2;180;156;240", "3": "38;2;180;156;240", "4": "38;2;180;156;240", "5": "38;2;180;156;240",
      "6": "38;2;53;50;63"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "38;2;180;156;240",
      "title": "38;2;201;197;212",
      "separator": "38;2;53;50;63"
    }
  },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "os" },
    { "type": "host", "key": "board" },
    { "type": "kernel", "key": "kern" },
    { "type": "uptime", "key": "up" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "wm", "key": "wm" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "packages", "key": "pkgs" },
    { "type": "command", "key": "make", "text": "printf 'godot %s' \"$(godot --version 2>/dev/null | cut -d. -f1-3)\"" },
    "break", "colors"
  ]
}
