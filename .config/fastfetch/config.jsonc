{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Arch companion to the Pi greeting: identical logo and layout, Arch-blue accents.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sh0ds.txt",
    "color": {
      "1": "38;2;23;147;209", "2": "38;2;23;147;209", "3": "38;2;23;147;209", "4": "38;2;23;147;209", "5": "38;2;23;147;209",
      "6": "38;2;74;74;74"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "38;2;23;147;209",
      "title": "38;2;196;201;206",
      "separator": "38;2;23;147;209"
    }
  },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "os" },
    { "type": "host", "key": "board" },
    { "type": "kernel", "key": "kern" },
    { "type": "uptime", "key": "up" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "wm", "key": "wm" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "packages", "key": "pkgs" },
    { "type": "command", "key": "langs", "text": "printf 'ghc %s' \"$(ghc --numeric-version 2>/dev/null || echo -)\"" },
    "break", "colors"
  ]
}
